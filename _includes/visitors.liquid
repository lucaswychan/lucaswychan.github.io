<div class="visitors">
  {% if site.visitor_map and site.visitor_map.clustrmaps and site.visitor_map.clustrmaps.id != '' %}
    <div class="clustrmaps-container text-center">
      {% assign map_id = site.visitor_map.clustrmaps.id | url_encode %}
      {% assign map_width = site.visitor_map.clustrmaps.width | default: 300 %}
      {% assign map_type = site.visitor_map.clustrmaps.type | default: 'map' %}

      {% if map_type == 'globe' %}
        <script async type="text/javascript" id="clstr_globe" src="https://clustrmaps.com/globe.js?d={{ map_id }}"></script>
      {% else %}
        {% assign cl = site.visitor_map.clustrmaps.colors.cluster | default: '080808' %}
        {% assign co = site.visitor_map.clustrmaps.colors.background | default: 'ffffff' %}
        {% assign cmo = site.visitor_map.clustrmaps.colors.most_visits | default: 'ff3636' %}
        {% assign cmn = site.visitor_map.clustrmaps.colors.new_visits | default: '00f500' %}
        {% assign ct = site.visitor_map.clustrmaps.colors.text | default: '808080' %}
        <script
          async
          type="text/javascript"
          id="clustrmaps"
          src="https://cdn.clustrmaps.com/map_v2.js?cl={{ cl }}&w={{ map_width }}&t=tt&d={{ map_id }}&co={{ co }}&cmo={{ cmo }}&cmn={{ cmn }}&ct={{ ct }}"
        ></script>
      {% endif %}
    </div>
    <!-- Keep a local globe link visible even when the external widget cannot load. -->
    <a class="visitor-map-link" href="https://clustrmaps.com/" title="Visitor map on ClustrMaps" target="_blank" rel="noopener noreferrer">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="64"
        height="64"
        viewBox="0 0 64 64"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="32" cy="32" r="28" />
        <ellipse cx="32" cy="32" rx="13" ry="28" />
        <ellipse cx="32" cy="32" rx="28" ry="11" />
        <path d="M4 32h56M32 4v56" />
      </svg>
      <span>Visitor map</span>
    </a>
  {% else %}
    <p class="text-muted text-center">Visitor map not configured. Please set your Clustrmaps ID in _config.yml.</p>
  {% endif %}
</div>
