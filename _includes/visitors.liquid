{% if site.visitor_map.stats4u.id %}
  <div class="visitors">
    <script
      async
      src="https://www.stats4u.net/js/globe.js"
      data-s4uid="{{ site.visitor_map.stats4u.id | escape }}"
      data-size="{{ site.visitor_map.stats4u.width | default: 130 }}"
      data-lang="en"
      data-form="dots"
      data-ui="none"
      data-count="1"
    ></script>
    <a
      class="visitor-map-link"
      href="https://www.stats4u.net/live/{{ site.visitor_map.stats4u.id | url_encode }}"
      target="_blank"
      rel="noopener noreferrer"
    >
      Visitor statistics
    </a>
  </div>
{% endif %}
